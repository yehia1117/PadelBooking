@model PadelBooking.Models.AdminResetPasswordViewModel
@{ ViewData["Title"] = "إعادة تعيين كلمة المرور"; }
<div class="auth-card mx-auto"><h2 class="fw-bold mb-3">إعادة تعيين كلمة المرور</h2>
<div class="alert alert-warning">تحقق من هوية العميل خارج الموقع قبل تعيين كلمة مرور جديدة.</div>
<p><strong>العميل:</strong> @Model.CustomerName</p><p><strong>رقم الموبايل:</strong> <span dir="ltr">@Model.Phone</span></p>
<form asp-action="ResetCustomerPassword" method="post">
@Html.AntiForgeryToken()<input asp-for="UserId" type="hidden"/><input asp-for="RequestId" type="hidden"/><input asp-for="CustomerName" type="hidden"/><input asp-for="Phone" type="hidden"/>
<div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-3"><label asp-for="NewPassword" class="form-label">كلمة المرور المؤقتة الجديدة</label><input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password"/></div>
<div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">تأكيد كلمة المرور</label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password"/></div>
<button class="btn btn-green w-100" type="submit">حفظ كلمة المرور</button>
<a asp-action="ResetRequests" class="btn btn-outline-secondary w-100 mt-2">رجوع</a></form></div>
