@model List<Booking>
@{ViewData["Title"]="تقارير الحجوزات";}
<h2 class="fw-bold mb-3">التقارير والإيرادات</h2><form method="get" class="date-picker-card mb-3"><label class="form-label">الشهر</label><div class="d-flex gap-2"><input type="month" name="month" value="@ViewBag.Month" class="form-control"/><button class="btn btn-green">عرض</button></div></form>
<div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="stat-card"><div>كل الحجوزات</div><div class="stat-number">@ViewBag.Total</div></div></div><div class="col-6 col-lg-3"><div class="stat-card"><div>المؤكدة</div><div class="stat-number">@ViewBag.Confirmed</div></div></div><div class="col-6 col-lg-3"><div class="stat-card"><div>قيد الانتظار</div><div class="stat-number">@ViewBag.Pending</div></div></div><div class="col-6 col-lg-3"><div class="stat-card"><div>الإيراد التقديري</div><div class="stat-number">@(((decimal)ViewBag.Revenue).ToString("N2")) ج</div></div></div></div>
<div class="table-responsive"><table class="table booking-table"><thead><tr><th>التاريخ</th><th>البداية</th><th>النهاية</th><th>الحالة</th></tr></thead><tbody>@foreach(var b in Model){<tr><td>@b.StartDateTime.ToString("dd/MM/yyyy")</td><td>@b.StartDateTime.ToString("h:mm tt")</td><td>@b.EndDateTime.ToString("h:mm tt")</td><td>@b.Status</td></tr>}</tbody></table></div><p class="text-secondary small">الإيراد محسوب من الحجوزات المؤكدة فقط وبناءً على سعر الساعة الحالي.</p>
