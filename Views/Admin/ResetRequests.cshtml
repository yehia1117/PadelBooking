@model IEnumerable<PadelBooking.Models.PasswordResetRequest>
@{ ViewData["Title"] = "طلبات استعادة كلمة المرور"; }
<div class="container py-4"><h2 class="fw-bold mb-3">طلبات استعادة كلمة المرور</h2>
@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
@if (!Model.Any()) { <div class="alert alert-info">لا توجد طلبات معلقة حاليًا.</div> }
else { <div class="table-responsive"><table class="table table-striped"><thead><tr><th>رقم العميل</th><th>تاريخ الطلب</th><th></th></tr></thead><tbody>
@foreach (var request in Model) { <tr><td dir="ltr">@request.Phone</td><td>@request.CreatedAt.ToString("yyyy/MM/dd hh:mm tt")</td><td><a class="btn btn-sm btn-primary" asp-action="ResetCustomerPassword" asp-route-id="@request.Id">إعادة تعيين كلمة المرور</a></td></tr> }
</tbody></table></div> }</div>
