@model List<Booking>
@{ViewData["Title"]="سجل الحجوزات";}
<h2 class="fw-bold mb-3">سجل الحجوزات السابقة</h2><form method="get" class="date-picker-card mb-3"><div class="row g-2"><div class="col-md-3"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="اسم العميل أو الهاتف"/></div><div class="col-md-3"><input type="date" name="from" value="@ViewBag.From" class="form-control"/></div><div class="col-md-3"><input type="date" name="to" value="@ViewBag.To" class="form-control"/></div><div class="col-md-2"><select name="status" class="form-select"><option value="">كل الحالات</option>@foreach(var x in new[]{("Pending","منتظر"),("Confirmed","مؤكد"),("Rejected","مرفوض"),("Cancelled","ملغي")}){<option value="@x.Item1" selected="@(ViewBag.Status==x.Item1)">@x.Item2</option>}</select></div><div class="col-md-1"><button class="btn btn-green w-100">بحث</button></div></div></form>
<div class="table-responsive"><table class="table booking-table"><thead><tr><th>التاريخ</th><th>الوقت</th><th>العميل</th><th>الهاتف</th><th>الحالة</th><th>ملاحظات</th></tr></thead><tbody>@foreach(var b in Model){<tr><td>@b.StartDateTime.ToString("dd/MM/yyyy")</td><td>@b.StartDateTime.ToString("h:mm tt")</td><td>@b.User?.Name</td><td dir="ltr">@b.User?.Phone</td><td>@b.Status</td><td>@b.AdminNotes</td></tr>}</tbody></table></div><p class="text-secondary">يتم عرض آخر 500 نتيجة كحد أقصى.</p>
