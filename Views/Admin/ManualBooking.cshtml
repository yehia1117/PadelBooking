@{ViewData["Title"]="حجز يدوي";var users=(List<User>)ViewBag.Users;}
<h2 class="fw-bold mb-3">إضافة حجز يدوي</h2><form asp-action="CreateManual" method="post" class="date-picker-card"><div class="mb-3"><label class="form-label">العميل المسجل</label><select name="userId" class="form-select" required><option value="">اختر العميل</option>@foreach(var u in users){<option value="@u.Id">@u.Name - @u.Phone</option>}</select></div><div class="mb-3"><label class="form-label">موعد بداية الحجز</label><input type="datetime-local" name="startDateTime" class="form-control" required value="@($"{ViewBag.Date}T16:00")"/></div><button class="btn btn-green">تأكيد الحجز اليدوي</button></form><p class="text-secondary mt-3">يجب أن يكون العميل مسجلًا بالموقع أولًا.</p>
