@{ ViewData["Title"] = "نسيت كلمة المرور"; }
<div class="auth-card mx-auto">
    <h2 class="fw-bold mb-2">نسيت كلمة المرور؟</h2>
    <p class="text-secondary">اكتب رقم الموبايل المسجل في حسابك، وسيصل طلب الاستعادة إلى إدارة Padel PIN.</p>
    @if (TempData["Message"] != null) { <div class="alert alert-info">@TempData["Message"]</div> }
    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3"><label class="form-label">رقم الموبايل</label><input name="phone" class="form-control" inputmode="tel" placeholder="01xxxxxxxxx" required maxlength="20" /></div>
        <button class="btn btn-green w-100 btn-lg" type="submit">إرسال طلب الاستعادة</button>
    </form>
    <p class="mt-3 mb-0"><a asp-action="Login">العودة لتسجيل الدخول</a></p>
</div>
