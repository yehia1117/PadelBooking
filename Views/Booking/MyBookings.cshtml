@model List<Booking>
@{ ViewData["Title"] = "حجوزاتي"; }
<h2 class="fw-bold mb-3">حجوزاتي</h2>
@if (TempData["PaymentWhatsApp"] != null) { <div class="alert alert-warning">لاستكمال الحجز، ادفع قيمة الحجز وأرسل صورة التحويل على واتساب الملعب خلال 20 دقيقة. <a class="btn btn-success btn-sm ms-2" href="@TempData["PaymentWhatsApp"]" target="_blank" rel="noopener">إرسال صورة الدفع على واتساب</a></div> }
@if(!Model.Any()){<div class="empty-card text-center py-5"><div class="display-6">🎾</div><p class="mb-2">لسه مفيش حجوزات</p><a class="btn btn-green" asp-action="Index">احجز أول ميعاد</a></div>}
else {<div class="table-responsive"><table class="table align-middle booking-table"><thead><tr><th>رقم الحجز</th><th>اليوم</th><th>الميعاد</th><th>الحالة</th><th>ملاحظات الإدارة</th><th></th></tr></thead><tbody>
@foreach(var b in Model){<tr><td class="fw-semibold">@b.BookingNumber</td><td>@b.StartDateTime.ToString("dd/MM/yyyy")</td><td>@b.StartDateTime.ToString("h:mm tt").Replace("AM","ص").Replace("PM","م") – @b.EndDateTime.ToString("h:mm tt").Replace("AM","ص").Replace("PM","م")</td><td><span class="status status-@b.Status">@BookingStatusText(b.Status)</span></td><td>@b.AdminNotes</td><td>@if(b.Status=="Pending" && b.ExpiresAt.HasValue){<span class="small text-warning">بانتظار الدفع حتى @b.ExpiresAt.Value.ToString("hh:mm tt")</span>}</td></tr>}
</tbody></table></div>}
@functions { string BookingStatusText(string s) => s switch { "Pending"=>"في انتظار التأكيد", "Confirmed"=>"مؤكد", "Rejected"=>"مرفوض", "Cancelled"=>"ملغي", "Expired"=>"انتهت مهلة الدفع", _=>s}; }
