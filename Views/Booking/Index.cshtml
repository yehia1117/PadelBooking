@model List<DateTime>
@{ ViewData["Title"]="حجز ملعب"; var booked=(IEnumerable<dynamic>)ViewBag.Booked; var blocked=(IEnumerable<dynamic>)ViewBag.Blocked; var settings=(CourtSettings)ViewBag.Settings; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="fw-bold mb-1">احجز ملعبك</h2><p class="text-secondary mb-0">اختار اليوم والموعد المناسب</p></div><a asp-action="MyBookings" class="btn btn-outline-secondary">حجوزاتي</a></div>
<div class="alert alert-light border">ساعات العمل: @settings.OpenHour:00 – @(settings.CloseHour%24):00 · مدة الحجز: @settings.SlotMinutes دقيقة · سعر الساعة: @settings.PricePerHour.ToString("0.##") جنيه</div>
<form method="get" class="date-picker-card mb-4"><label class="form-label fw-semibold">تاريخ الحجز</label><div class="d-flex gap-2"><input type="date" name="date" value="@ViewBag.Date" min="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.AddDays(60).ToString("yyyy-MM-dd")" class="form-control"/><button class="btn btn-green">عرض المواعيد</button></div></form>
@if(!Model.Any()){<div class="empty-card text-center p-4">لا توجد مواعيد متاحة في هذا اليوم.</div>}
<div class="slot-grid">@foreach(var slot in Model){var end=slot.AddMinutes(settings.SlotMinutes);var isBooked=booked.Any(x=>((DateTime)x.StartDateTime)<end&&((DateTime)x.EndDateTime)>slot);var isBlocked=blocked.Any(x=>((DateTime)x.StartDateTime)<end&&((DateTime)x.EndDateTime)>slot);var past=slot<DateTime.Now;var label=slot.ToString("h:mm tt",CultureInfo.InvariantCulture).Replace("AM","ص").Replace("PM","م");<div class="slot-card @((isBooked||isBlocked)?"slot-booked":past?"slot-past":"slot-free")"><div class="slot-time">@label</div><div class="small mb-2">إلى @end.ToString("h:mm tt",CultureInfo.InvariantCulture).Replace("AM","ص").Replace("PM","م")</div>@if(isBooked){<span class="badge text-bg-secondary">محجوز</span>}else if(isBlocked){<span class="badge text-bg-secondary">مغلق</span>}else if(past){<span class="badge text-bg-light">انتهى</span>}else{<form asp-action="Create" method="post"><input type="hidden" name="startDateTime" value="@slot.ToString("yyyy-MM-ddTHH:mm:ss")"/><button class="btn btn-green w-100">اطلب الحجز</button></form>}</div>}</div>
