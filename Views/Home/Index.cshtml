@using System.Globalization
@{
    ViewData["Title"] = "الرئيسية";
    var settings = ViewBag.Settings as CourtSettings ?? new CourtSettings();
    string FormatHour(int hour) { var value = DateTime.Today.AddHours(hour); return $"{(value.Hour % 12 == 0 ? 12 : value.Hour % 12)} {(value.Hour < 12 ? "صباحًا" : "مساءً")}"; }
    var dayNames = new[] { "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت" };
    var selectedDays = settings.WorkingDays.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(x => int.TryParse(x, out var day) ? day : -1).Where(x => x >= 0 && x <= 6).OrderBy(x => x).ToArray();
    var daysText = selectedDays.Length == 7 ? "يوميًا" : string.Join("، ", selectedDays.Select(x => dayNames[x]));
}
<section class="hero rounded-4 p-4 p-md-5 mb-4">
 <div class="row align-items-center"><div class="col-lg-7">
  <span class="eyebrow">PLAY · BOOK · REPEAT</span><h1 class="display-5 fw-bold mt-2">أهلاً بك في Padel PIN 🎾</h1>
  <p class="lead">احجز ساعة لعب مع أصحابك. اختار اليوم والوقت، وطلبك هيتأكد من الإدارة.</p>
  <a class="btn btn-green btn-lg mt-2" asp-controller="Booking" asp-action="Index">احجز دلوقتي</a>
 </div><div class="col-lg-5 mt-4 mt-lg-0"><div class="court-art"><span>PADEL PIN</span><div class="court-lines"></div></div></div></div>
</section>
<div class="row g-3">
 <div class="col-md-4"><div class="feature-card"><h5>🕓 مواعيد اللعب</h5><p class="mb-0">@daysText من @FormatHour(settings.OpenHour) إلى @FormatHour(settings.CloseHour)</p></div></div>
 <div class="col-md-4"><div class="feature-card"><h5>⏱️ مدة الحجز</h5><p class="mb-0">@settings.SlotMinutes دقيقة لكل حجز</p></div></div>
 <div class="col-md-4"><div class="feature-card"><h5>✅ تأكيد الإدارة</h5><p class="mb-0">حجزك بيتأكد بعد مراجعة الإدارة</p></div></div>
</div>
